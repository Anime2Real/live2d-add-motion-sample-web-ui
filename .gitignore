# ローカル専用素材(Live2Dサンプルモデルの原本・プロンプト等。ライセンス上リポジトリに含めない)
local-assets/

# 実行用モデルデータ(Live2Dサンプルモデル。ライセンス上リポジトリに含めない)
models/

# 検証用スクリーンショット出力(tools/verify_browser.sh)
tmp-verify/

# セットアップ時に生成されるモデル設定(tools/setup_model.py)
model.config.json

# モデルごとのモーション定義は通常「作業成果物」扱い
# 同梱サンプルと Chii の本番定義は明示的に追跡する
motion-defs/*
!motion-defs/hiyori_pro_t11.py
!motion-defs/chii.py

# Python実行時に生成されるバイトコードキャッシュ
__pycache__/

# macOS
.DS_Store
